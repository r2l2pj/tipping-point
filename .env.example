# Copy to .env and fill in locally. Never commit real values.

# NASA Earthdata Login bearer token (https://urs.earthdata.nasa.gov ->
# "Generate Token") — canonical credential for NISAR/OPERA/IMERG/SMAP/LANCE.
EARTHDATA_TOKEN=

# Subscriber store. Unset = local SQLite at .data/tipping-point.sqlite; otherwise
# sqlite:<path> for a specific SQLite file, or a postgres:// URL (Neon).
# DATABASE_URL=sqlite:<path>
# DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require

# Google Earth Engine Cloud project (shared project for the team)
GEE_PROJECT=

# Google Earth Engine service account — set one of:
#   GOOGLE_APPLICATION_CREDENTIALS: local absolute path to the JSON key file
#     (keep the key OUT of the repo).
#   GCP_SA_KEY: the JSON key CONTENTS (CI secret).
# GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/<sa-key>.json
# GCP_SA_KEY=
