# Copy to .env and fill in locally. Never commit real values.

# NASA Earthdata Login bearer token (https://urs.earthdata.nasa.gov ->
# "Generate Token") — canonical credential for NISAR/OPERA/IMERG/SMAP/LANCE.
EARTHDATA_TOKEN=


# Google Earth Engine Cloud project (shared project for the team)
GEE_PROJECT=

# Google Earth Engine service account — set one of:
#   GOOGLE_APPLICATION_CREDENTIALS: local absolute path to the JSON key file
#     (keep the key OUT of the repo).
#   GCP_SA_KEY: the JSON key CONTENTS (CI secret).
# GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/<sa-key>.json
# GCP_SA_KEY=

# --- app/ (Next.js runtime; copy into app/.env.local for `bun run dev`) ---
# GEE_PROJECT / GCP_SA_KEY / EARTHDATA_TOKEN above are shared with the app.
# Data read order (L26): GitHub raw `fallback` branch -> built-in public Neon
# bucket (dropped in L53 step 3b) -> bundled app/public/data. Leave DATA_BASE_URL UNSET; when set it
# becomes the ONLY remote source (tests use it to force the bundled copy).
DATA_BASE_URL=
# Earth Engine at runtime is OFF by default (L25). 1/true enables the GEE API
# routes, the loader overlay and the health probe; needs GEE_PROJECT + GCP_SA_KEY (above).
GEE_ENABLED=
# Legacy fallback name for GCP_SA_KEY
GEE_SERVICE_ACCOUNT_KEY=
# Canonical public app URL
APP_URL=
# Command Center: refresh period of the live run in hours (default 3). The
# screen calls live data "stale" after two periods. Public, fixed at build time.
NEXT_PUBLIC_REFRESH_HOURS=
