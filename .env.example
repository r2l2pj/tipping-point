# NASA Earthdata Login (https://urs.earthdata.nasa.gov) — required for NISAR/OPERA/LANCE
# Prefer a ~/.netrc entry: machine urs.earthdata.nasa.gov login <user> password <pass>
EDL_USER=
EDL_PASS=

# Google Earth Engine Cloud project (shared project for the team)
GEE_PROJECT=

# Google Earth Engine service account — absolute path to the JSON key file.
# Keep the key OUT of the repo; it lives at ../<sa-key>.json relative to this repo.
# The pipeline reads GCP_SA_KEY; GOOGLE_APPLICATION_CREDENTIALS is the Google-standard
# equivalent some tools (gcloud, google-cloud-*) pick up automatically. Set one of them.
# GCP_SA_KEY=/home/<user>/code/r2l2pj/<sa-key>.json
# GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/code/r2l2pj/<sa-key>.json
