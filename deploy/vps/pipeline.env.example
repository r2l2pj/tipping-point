# Environment of the tipping-point data jobs on the VPS.
# Install as /etc/tipping-point/pipeline.env, owner root, mode 0600. The units
# read it with EnvironmentFile=; the pipeline user never reads the file itself.
# This example lists names only. Never put a real value in the repository, in a
# chat or in a log. One KEY=value per line, no quotes, no "export", no spaces
# around "=".
#
# Where each value comes from: the GitHub Actions secret or variable of the same
# name (Settings > Secrets and variables > Actions).

# secret: NASA Earthdata token (docs/EARTHDATA_TOKEN.md). Needed by every job; the
# preflight and a start refuse an empty value.
EARTHDATA_TOKEN=

# secret: the Google Cloud service-account key JSON (GCP_SA_KEY), as ONE line of
# base64: base64 < key.json | tr -d '\n'. The runner decodes it to a 0600 file
# that exists only while a job runs. Needed only by the validation and reference
# jobs, which use Earth Engine. OPTIONAL for now and nisar: the now job runs with
# NOW_LOCAL=1 (no Earth Engine) and nisar only searches ASF metadata, so leave it
# empty to run them without a Google key (the log says so once). A value that is
# set must be good, for every job.
GCP_SA_KEY_B64=

# variable: the Google Earth Engine project (GEE_PROJECT). Needed only by the
# validation and reference jobs, like the key above.
GEE_PROJECT=

# variable NOW_P_TRIGGER: 1 turns the p_trigger step of the Now job on. Leave
# it empty to keep it off, like the repository variable.
NOW_P_TRIGGER=

# Publishing to the fallback branch. 0 (or unset) builds and checks the snapshot
# and pushes nothing. Set it to 1 only at cutover, after the GitHub workflows
# are disabled (runbook).
PIPELINE_PUBLISH=0

# The push credential (the default way): a GitHub token with "Contents: read and
# write" on the tipping-point repository only (a fine-grained token is enough).
# Publishing and the optional upload of oversized files as release assets (needs
# the gh command) use it. The runner hands it to the publish step only, through a
# git credential helper and the environment; it is never in the remote URL, in
# .git/config, in a command line or in a log. If the VPS already holds such a
# token, put its value here. The preflight always checks it (a dry-run push, nothing
# is written), and a run with PIPELINE_PUBLISH=1 needs it. Never type it on a command
# line: edit this file with an editor.
GH_TOKEN=
# The alternative is an SSH deploy key (runbook, "SSH deploy key"). Then GH_TOKEN
# is optional (release assets only):
# PIPELINE_PUSH_AUTH=ssh

# Optional tuning (defaults shown).
# Free space (MB) needed under the state directory and the checkout, or the run stops.
# PIPELINE_MIN_FREE_MB=10240
# Seconds one job may run, 60 to 86400. Unset: the workflow's limit (now 2700, the others
# 3600). Raise it for the first, cold run, and raise TimeoutStartSec of the unit with it
# (runbook), because the unit's own limit is the outer one. Anything else is refused.
# PIPELINE_TIMEOUT_S=
# PIPELINE_LOCK_WAIT_S=3300
# STALE_AFTER_S=21600
