# tipping-point Now backup run (starts a Now run when the last success is older than 3.5 h)
# Replaces .github/workflows/now-watchdog.yml (dispatch step).
# SAFETY: this host also runs unrelated services of another company ("FE
# services"), currently stopped. This unit and its script touch only
# tipping-point things (see the script header). The unit has no [Install]
# section; its timer is installed disabled and enabled at cutover (runbook:
# docs/DEPLOY-VPS.md, "Running without GitHub Actions").
[Unit]
Description=tipping-point Now backup run (starts a Now run when the last success is older than 3.5 h)
Documentation=file:///opt/tipping-point/docs/DEPLOY-VPS.md
OnFailure=tipping-point-notify@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tipping-pipeline
Group=tipping-pipeline
EnvironmentFile=/etc/tipping-point/pipeline.env
Environment=HOME=/var/lib/tipping-point-pipeline
Environment=PIPELINE_STATE_DIR=/var/lib/tipping-point-pipeline
Environment=PIPELINE_CHECKOUT=/opt/tipping-point
WorkingDirectory=/var/lib/tipping-point-pipeline
ExecStart=/usr/local/lib/tipping-point-pipeline/pipeline-run.sh --if-stale 12600 now
# Outer limit. The run limit (45 min, like now.yml) is enforced inside the
# script with timeout(1). This job never waits for the shared lock.
TimeoutStartSec=2900
SyslogIdentifier=tipping-point-now-backup
Nice=10
# A host-wide memory shortage picks this job before the app or any other service.
OOMScoreAdjust=500
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=50
CPUQuota=200%
MemoryHigh=3500M
MemoryMax=4G
TasksMax=1024
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tipping-point-pipeline /opt/tipping-point
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
