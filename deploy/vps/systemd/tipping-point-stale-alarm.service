# tipping-point stale-data alarm (fails when the published Now manifest is older than 6 h)
# Replaces .github/workflows/now-watchdog.yml (stale-data alarm step).
# SAFETY: this host also runs unrelated services of another company ("FE
# services"), currently stopped. This unit and its script touch only
# tipping-point things (see the script header). The unit has no [Install]
# section; its timer is installed disabled and enabled at cutover (runbook:
# docs/DEPLOY-VPS.md, "Running without GitHub Actions").
[Unit]
Description=tipping-point stale-data alarm (fails when the published Now manifest is older than 6 h)
Documentation=file:///opt/tipping-point/docs/DEPLOY-VPS.md
OnFailure=tipping-point-notify@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tipping-pipeline
Group=tipping-pipeline
Environment=HOME=/var/lib/tipping-point-pipeline
Environment=PIPELINE_STATE_DIR=/var/lib/tipping-point-pipeline
Environment=PIPELINE_CHECKOUT=/opt/tipping-point
WorkingDirectory=/var/lib/tipping-point-pipeline
ExecStart=/usr/local/lib/tipping-point-pipeline/watchdog.sh
# Outer limit for one run.
TimeoutStartSec=300
SyslogIdentifier=tipping-point-stale-alarm
Nice=10
MemoryMax=512M
TasksMax=128
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tipping-point-pipeline /opt/tipping-point
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
