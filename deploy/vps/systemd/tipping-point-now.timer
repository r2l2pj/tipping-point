# tipping-point Now job (modo-agora): every 3 hours at :17 UTC
# Replaces the schedule of .github/workflows/now.yml. Installed disabled; enable it at cutover.
[Unit]
Description=tipping-point Now job (modo-agora): every 3 hours at :17 UTC

[Timer]
OnCalendar=*-*-* 00,03,06,09,12,15,18,21:17:00 UTC
Persistent=true
AccuracySec=1min
Unit=tipping-point-now.service

[Install]
WantedBy=timers.target
