# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets — never commit
.env
*.netrc

# Raw satellite data (large, re-downloadable)
data/raw/
*.h5
*.hdf5
*.nc
*.zip

# OS
.DS_Store

# local subscriber store (sqlite default backend)
.data/

# pipeline scratch outputs (large, rebuilt by tools/)
intermediate/

# never commit credential keys
*-service-account*.json
hermes-*.json
gcp-*.json
service-account*.json
static/cache/

# static geo downloads (large rasters stay local; manifests are committed)
data/now/static/*/*
!data/now/static/*/manifest.json

# ML training store (rebuilt by `python -m ml.local db`; Lucas publishes the full one deliberately)
data/ml/*.sqlite
data/ml/*.sqlite.tmp

# 90 m HAND proxy (static-v1 Release asset, 390 MB)
data/static/south_brazil/terrain/hand_90m.tif

# built by tools/build_sqlite.py on the fallback branch / CI only
data/tipping_point.sqlite
# L30-clim whole-year IMERG 0.1 climatology (Release static-v1 asset; never commit)
data/static/south_brazil/clim/clim_imerg_0p1.tif
*.tmp.tif

# L35 upstream-basin rain cubes + IMERG per-day cache (large, re-downloadable)
intermediate/
data/now/history/

# L53 monorepo: the Next.js app under app/ (its own app/.gitignore also applies)
app/node_modules/
app/.next/
app/.data/
app/*.tsbuildinfo
app/next-env.d.ts
app/.env*
!app/.env.example
